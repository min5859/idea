# ── HermesTalk 환경 변수 ──
# 이 파일을 .env.local 로 복사한 뒤 값을 채운다.  cp .env.example .env.local

# 동작 모드: mock(기본, Hermes 없이도 전체 데모 동작) | real(실제 게이트웨이 연동)
HERMES_MODE=mock

# ── 아래는 HERMES_MODE=real 일 때만 필요 ──

# 게이트웨이 인증 키 (Hermes 서버 .env 의 API_SERVER_KEY 와 동일 값)
# 서버 전용 — 절대 NEXT_PUBLIC_ 접두사 붙이지 말 것(브라우저 노출 금지).
HERMES_API_KEY=

# 기본 게이트웨이 baseUrl. config/agents.ts 의 각 에이전트 baseUrl 이 있으면 그게 우선.
# ⚠️ 프로필=게이트웨이=포트 구조라, real 에이전트가 여러 개면 포트도 각각 다르다.
#    예) 디버그봇 :8642, 팀리더봇 :8643 …  각 baseUrl 은 config/agents.ts 에 기입.
HERMES_BASE_URL=http://localhost:8642/v1
