# ── HermesTalk 환경 변수 (Hermes Studio 포크 기준) ──
# 이 파일을 .env.local 로 복사한 뒤 값을 채운다.  cp .env.example .env.local
# mock 모드는 없다. 처음부터 real 게이트웨이에 붙는다.
# (변수명은 Studio 코드 기준: src/server/gateway-capabilities.ts)

# 기본 Hermes 게이트웨이 (capability 자동 감지의 출발점)
HERMES_API_URL=http://127.0.0.1:8642

# 게이트웨이 인증 키 (Hermes 서버 .env 의 API_SERVER_KEY 와 동일 값)
# 서버 전용 — 브라우저에 노출 금지.
HERMES_API_TOKEN=

# ── PC별 다중 게이트웨이 ──
# 프로필=게이트웨이=포트 구조라, 에이전트가 여러 개면 게이트웨이도 각각이다.
# 이 PC에서 띄운 게이트웨이 후보 목록(probeGateway 가 살아있는 것만 채팅방으로 표시).
# 예) 집 PC 와 회사 PC 가 서로 다른 값을 가진다 → 그래서 PC별로 보이는 에이전트가 달라진다.
# (실제 키 이름/형식은 포크에 맞춰 Phase 2에서 확정. 아래는 의도 메모.)
# HERMES_GATEWAYS=http://127.0.0.1:8642,http://127.0.0.1:8643

# ── 텔레그램 ──
# 텔레그램 연동은 우리 앱이 아니라 Hermes 게이트웨이 .env 에서 켠다(프로필별 봇 토큰 1개).
# 여기서 설정할 것 없음 — 메모 목적.
