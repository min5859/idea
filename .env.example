# Hermes Crew — 환경 변수
# 이 파일을 `.env` 로 복사한 뒤 사내 실제값으로 채우세요. (.env 는 git 에 올리지 않음)

# Hermes 서버 호스트 (백엔드 래퍼가 호출). 백엔드와 같은 서버면 127.0.0.1
HERMES_HOST=127.0.0.1

# Hermes API 서버 키 — 서버의 각 프로필 .env 에 설정한 API_SERVER_KEY 와 동일해야 함
API_SERVER_KEY=change-me

# hermes 실행 파일 (PATH 에 있으면 그냥 hermes)
HERMES_BIN=hermes

# 백엔드 래퍼 바인딩 (브라우저가 접속하는 주소)
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8080
